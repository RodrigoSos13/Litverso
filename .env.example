# Opcional: Docker Compose funciona sem criar um .env.
# Transferir apenas livros locais para Atlas (script books:migrate):
# ATLAS_MONGODB_URI=mongodb+srv://USUARIO:SENHA@CLUSTER.mongodb.net/litverse
# LOCAL_BOOKS_MONGODB_URI=mongodb://127.0.0.1:27018/litverse
# Ao mudar a porta, atualize também APP_ORIGIN.
APP_PORT=8080
APP_ORIGIN=http://localhost:8080
# Opcional, apenas para popular o banco de demonstração:
# SEED_PASSWORD=<defina uma senha de 8 a 128 caracteres>

# Chave privada do backend: ative a Books API no Google Cloud.
GOOGLE_BOOKS_API_KEY=

# Sincronização do catálogo em segundo plano (opcional):
CATALOG_SYNC_INTERVAL_HOURS=12
CATALOG_SYNC_PAGES=3
# CATALOG_SYNC_QUERIES=Stephen King|Machado de Assis|Clarice Lispector

# Confirmação de e-mail e recuperação de senha (somente backend):
# EMAIL_PROVIDER: resend (compatível com a configuração atual) ou gmail (HTTPS/OAuth).
# Configuração completa do Gmail: docs/gmail-api.md
EMAIL_PROVIDER=resend
GMAIL_USER=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Gerado localmente com npm run gmail:authorize --prefix backend (não é senha de app).
GMAIL_REFRESH_TOKEN=
RESEND_API_KEY=
# Remetente em domínio verificado no Resend, por exemplo: litverso <contato@seu-dominio.com>
EMAIL_FROM=
# Gere com: openssl rand -hex 32. Mantenha estável e nunca envie ao frontend.
EMAIL_CODE_SECRET=

# Duas chaves DIFERENTES, cada uma gerada com openssl rand -hex 32.
# Guarde backup seguro: substituir ou perder estas chaves impede acesso aos e-mails.
EMAIL_ENCRYPTION_KEY=
EMAIL_LOOKUP_KEY=

# false desativa apenas a sincronização automática; importação manual continua disponível.
CATALOG_SYNC_ENABLED=true
