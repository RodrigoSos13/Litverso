PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/litverse
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
FRONTEND_ORIGIN=http://localhost:5173
# Render: true serve frontend/dist junto da API (execute o build antes).
SERVE_FRONTEND=false
# Defina SEED_PASSWORD antes de executar npm run seed (8 a 128 caracteres).

# Chave privada do backend: ative a Books API no Google Cloud.
GOOGLE_BOOKS_API_KEY=

# Confirmação de e-mail e recuperação de senha (somente backend):
RESEND_API_KEY=
# Remetente em domínio verificado no Resend, por exemplo: litverso <contato@seu-dominio.com>
EMAIL_FROM=
# Gere com: openssl rand -hex 32. Mantenha estável e nunca envie ao frontend.
EMAIL_CODE_SECRET=

# Duas chaves DIFERENTES, cada uma gerada com openssl rand -hex 32.
# Guarde backup seguro: substituir ou perder estas chaves impede acesso aos e-mails.
EMAIL_ENCRYPTION_KEY=
EMAIL_LOOKUP_KEY=

# false desativa apenas a sincronização automática; importação manual continua disponível.
CATALOG_SYNC_ENABLED=true
