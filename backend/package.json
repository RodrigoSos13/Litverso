{
  "name": "litverse-backend",
  "version": "1.0.0",
  "description": "Backend API for litverso literary social network",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "catalog:sync:atlas": "node scripts/sync-atlas-catalog.js",
    "books:migrate": "node scripts/migrate-books.js",
    "db:start": "bash ./scripts/start-local-mongo.sh",
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "seed": "node src/seed.js",
    "test": "node --test",
    "user:set-password": "node scripts/set-password.js",
    "synopses:refresh": "node scripts/refresh-synopses.js",
    "catalog:sync": "node src/catalogWorker.js --once"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mongoose": "^8.6.1"
  }
}
